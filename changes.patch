+import XCTest
+@testable import AIAgentModel
+
+final class AIAgentModelTests: XCTestCase {
+    func testPrimaryLanguageIsTheLargest() {
+        let files = [
+            AgentArtifactFile(name: "index.html", language: "html", text: String(repeating: "<p></p>\n", count: 20)),
+            AgentArtifactFile(name: "style.css", language: "css", text: String(repeating: "a{}\n", count: 10)),
+            AgentArtifactFile(name: "app.js", language: "javascript", text: String(repeating: "let a = 1;\n", count: 30)),
+            AgentArtifactFile(name: "notes.txt", language: "text", text: String(repeating: "x", count: 10_000))
+        ]
+        let artifact = AgentArtifact(id: 1, runId: 1, kind: .project, typeTitle: "Игра", title: "T", description: "", createdAt: 0.0, stats: AgentArtifactStats(seconds: 1.0, steps: 1, files: 4, lines: 1, bytes: 1), files: files, entryFileName: nil, event: nil, path: [])
+        XCTAssertEqual(artifact.primaryLanguage, AgentCodeLanguage(name: "JavaScript", color: 0xF1E05A))
+        XCTAssertNil(AgentCodeLanguage(fileLanguage: "text"))
+        XCTAssertEqual(AgentCodeLanguage(fileLanguage: "markup")?.name, "HTML")
+    }
+
+    private let samplePrompts = [
+        "Можем ли мы создать игру?",
+        "Сделай игру «Змейка»",
+        "создай тг маркет",
+        "сделай сайт для кофейни",
+        "Ассаламу алейкум брат, как ты",
+        "привет",
+        "Напомни о встрече с Сашей завтра в 10",
+        "найди дешёвые билеты в Стамбул",
+        "что ты умеешь?",
+        "расскажи анекдот",
+        "Make a game",
+        "Build a habit tracker app",
+        "Can you build me a website for my coffee shop?",
+        "Remind me about the meeting with Sasha tomorrow at 10",
+        "Find cheap flights to Istanbul",
+        "Hi, how are you?",
+        "What can you do?",
+        "Tell me a joke"
+    ]
+
+    func testDurations() {
+        XCTAssertEqual(AgentFormatting.duration(4.2, isRussian: true), "4 с")
+        XCTAssertEqual(AgentFormatting.duration(72, isRussian: true), "1 мин 12 с")
+        XCTAssertEqual(AgentFormatting.duration(120, isRussian: true), "2 мин")
+        XCTAssertEqual(AgentFormatting.duration(3900, isRussian: true), "1 ч 5 мин")
+        XCTAssertEqual(AgentFormatting.duration(72, isRussian: false), "1m 12s")
+        XCTAssertEqual(AgentFormatting.clock(72), "1:12")
+    }
+
+    func testRussianPlurals() {
+        let expected: [Int: String] = [1: "1 шаг", 2: "2 шага", 5: "5 шагов", 11: "11 шагов", 12: "12 шагов", 21: "21 шаг", 22: "22 шага", 111: "111 шагов"]
+        for (count, string) in expected {
+            XCTAssertEqual(AgentFormatting.steps(count, isRussian: true), string)
+        }
+        XCTAssertEqual(AgentFormatting.files(3, isRussian: true), "3 файла")
+        XCTAssertEqual(AgentFormatting.lines(112, isRussian: true), "112 строк")
+        XCTAssertEqual(AgentFormatting.lines(21, isRussian: true), "21 строка")
+    }
+
+    func testBytes() {
+        XCTAssertEqual(AgentFormatting.bytes(820, isRussian: true), "820 Б")
+        XCTAssertEqual(AgentFormatting.bytes(27 * 1024, isRussian: true), "27 КБ")
+        XCTAssertEqual(AgentFormatting.bytes(1258291, isRussian: true), "1,2 МБ")
+    }
+
+    func testMarkdown() {
+        let parsed = AgentMarkdown.parse("Готово! Сделал **игру** и `index.html`.")
+        XCTAssertEqual(parsed.text, "Готово! Сделал игру и index.html.")
+        XCTAssertEqual(parsed.spans.count, 2)
+        XCTAssertEqual((parsed.text as NSString).substring(with: parsed.spans[0].range), "игру")
+        XCTAssertEqual(parsed.spans[0].kind, .bold)
+        XCTAssertEqual((parsed.text as NSString).substring(with: parsed.spans[1].range), "index.html")
+        XCTAssertEqual(parsed.spans[1].kind, .code)
+
+        let unbalanced = AgentMarkdown.parse("2 ** 3 и `код")
+        XCTAssertEqual(unbalanced.text, "2 ** 3 и `код")
+        XCTAssertTrue(unbalanced.spans.isEmpty)
+    }
+
+    func testRouting() {
+        XCTAssertEqual(AgentDemoPlanner.intent(for: "Можем ли мы создать игру?"), .build(.game))
+        XCTAssertEqual(AgentDemoPlanner.intent(for: "Сделай игру «Змейка»"), .build(.game))
+        XCTAssertEqual(AgentDemoPlanner.intent(for: "создай тг маркет"), .build(.miniApp))
+        XCTAssertEqual(AgentDemoPlanner.intent(for: "сделай сайт для кофейни"), .build(.site))
+        XCTAssertEqual(AgentDemoPlanner.intent(for: "Ассаламу алейкум брат, как ты"), .greeting)
+        XCTAssertEqual(AgentDemoPlanner.intent(for: "привет"), .greeting)
+        XCTAssertEqual(AgentDemoPlanner.intent(for: "Напомни о встрече с Сашей завтра в 10"), .calendar)
+        XCTAssertEqual(AgentDemoPlanner.intent(for: "найди дешёвые билеты в Стамбул"), .search)
+        XCTAssertEqual(AgentDemoPlanner.intent(for: "что ты умеешь?"), .capabilities)
+        XCTAssertEqual(AgentDemoPlanner.intent(for: "расскажи анекдот"), .other)
+    }
+
+    func testEnglishRouting() {
+        XCTAssertEqual(AgentDemoPlanner.intent(for: "Make a game"), .build(.game))
+        XCTAssertEqual(AgentDemoPlanner.intent(for: "Can you build me a website for my coffee shop?"), .build(.site))
+        XCTAssertEqual(AgentDemoPlanner.intent(for: "Build a habit tracker app"), .build(.miniApp))
+        XCTAssertEqual(AgentDemoPlanner.intent(for: "Remind me about the meeting with Sasha tomorrow at 10"), .calendar)
+        XCTAssertEqual(AgentDemoPlanner.intent(for: "Find cheap flights to Istanbul"), .search)
+        XCTAssertEqual(AgentDemoPlanner.intent(for: "What can you do?"), .capabilities)
+        XCTAssertEqual(AgentDemoPlanner.intent(for: "Hi"), .greeting)
+        // "this" is not "hi", and writing a poem is not building an app.
+        XCTAssertEqual(AgentDemoPlanner.intent(for: "This is great"), .other)
+        XCTAssertEqual(AgentDemoPlanner.intent(for: "Write me a poem"), .other)
+    }
+
+    func testEnglishTitles() {
+        XCTAssertEqual(AgentDemoPlanner.projectTitle(prompt: "Make a game called Space Run", kind: .game), "Space Run")
+        XCTAssertEqual(AgentDemoPlanner.projectTitle(prompt: "Make a game", kind: .game), "Starfall")
+        XCTAssertEqual(AgentDemoPlanner.projectTitle(prompt: "Build a habit tracker app", kind: .miniApp), "Habit Tracker")
+        XCTAssertEqual(AgentDemoPlanner.eventTitle(prompt: "Remind me about the meeting with Sasha tomorrow at 10"), "Meeting with Sasha")
+    }
+
+    func testTitles() {
+        XCTAssertEqual(AgentDemoPlanner.projectTitle(prompt: "Сделай игру «Змейка»", kind: .game), "Змейка")
+        XCTAssertEqual(AgentDemoPlanner.projectTitle(prompt: "создай тг маркет", kind: .miniApp), "ТГ Маркет")
+        XCTAssertEqual(AgentDemoPlanner.projectTitle(prompt: "Можем ли мы создать игру?", kind: .game), "Starfall")
+        XCTAssertEqual(AgentDemoPlanner.eventTitle(prompt: "Напомни о встрече с Сашей завтра в 10"), "Встреча с Сашей")
+    }
+
+    func testEventParsing() {
+        var calendar = Calendar(identifier: .gregorian)
+        calendar.timeZone = TimeZone.current
+        let now = calendar.date(from: DateComponents(year: 2026, month: 10, day: 28, hour: 15, minute: 0))!
+        let event = AgentDemoPlanner.event(from: "Напомни о встрече с Сашей завтра в 10", now: now)
+        let start = Date(timeIntervalSince1970: event.startDate)
+        XCTAssertEqual(calendar.component(.day, from: start), 29)
+        XCTAssertEqual(calendar.component(.hour, from: start), 10)
+        XCTAssertEqual(AgentDemoPlanner.formatEventDate(event.startDate, now: now), "tomorrow at 10:00")
+
+        let english = AgentDemoPlanner.event(from: "Remind me about the meeting with Sasha tomorrow at 7 pm", now: now)
+        XCTAssertEqual(calendar.component(.hour, from: Date(timeIntervalSince1970: english.startDate)), 19)
+        XCTAssertEqual(english.title, "Meeting with Sasha")
+    }
+
+    func testScriptInvariants() {
+        let now = Date(timeIntervalSince1970: 1_800_000_000)
+        for prompt in self.samplePrompts {
+            for connected in [false, true] {
+                let script = AgentDemoPlanner.script(for: prompt, now: now, calendarConnected: connected)
+                var ids = Set<String>()
+                var planCount = 0
+                for item in script.items {
+                    XCTAssertFalse(ids.contains(item.id), "duplicate id \(item.id) in \(prompt)")
+                    ids.insert(item.id)
+                    switch item {
+                    case let .think(think):
+                        XCTAssertGreaterThan(think.seconds, 0)
+                        XCTAssertFalse(think.text.isEmpty)
+                    case let .plan(plan):
+                        planCount = plan.items.count
+                        XCTAssertGreaterThan(plan.seconds, 0)
+                    case let .tool(tool):
+                        XCTAssertGreaterThan(tool.seconds, 0)
+                        if let index = tool.completesPlanItem {
+                            XCTAssertTrue(index >= 0 && index < planCount, "plan item \(index) out of range in \(prompt)")
+                        }
+                        if let liveCode = tool.liveCode {
+                            let typing = Double(liveCode.lines.count) / liveCode.linesPerSecond
+                            XCTAssertLessThanOrEqual(typing, tool.seconds * 0.9, "\(liveCode.fileName) types longer than its step")
+                        }
+                    case let .note(note):
+                        XCTAssertGreaterThan(note.seconds, 0)
+                    case .permission:
+                        break
+                    }
+                }
+                XCTAssertGreaterThanOrEqual(script.pathDuration, 1.0, prompt)
+                XCTAssertLessThanOrEqual(script.pathDuration, 40.0, prompt)
+                XCTAssertFalse(script.answer.isEmpty)
+                XCTAssertFalse(self.containsEmoji(script.answer), prompt)
+                if let artifact = script.artifact {
+                    for file in artifact.files {
+                        XCTAssertFalse(self.containsEmoji(file.text), file.name)
+                        XCTAssertLessThanOrEqual(file.lineCount, 140, file.name)
+                    }
+                }
+            }
+        }
+    }
+
+    func testPayloadRoundTripAndSize() {
+        let now = Date(timeIntervalSince1970: 1_800_000_000)
+        let script = AgentDemoPlanner.script(for: "Сделай игру", now: now)
+        guard let draft = script.artifact else {
+            XCTFail("no artifact")
+            return
+        }
+        let artifact = AgentArtifact(id: 1, runId: 2, kind: draft.kind, typeTitle: draft.typeTitle, title: draft.title, description: draft.description, createdAt: now.timeIntervalSince1970, stats: AgentArtifactStats(seconds: 28, steps: 9, files: draft.files.count, lines: draft.files.reduce(0, { $0 + $1.lineCount }), bytes: draft.files.reduce(0, { $0 + $1.byteCount })), files: draft.files, entryFileName: draft.entryFileName, event: nil, path: [AgentPathSummaryItem(icon: .code, title: "Написал index.html", seconds: 3)])
+        let step = AgentStep(id: "write", kind: .tool, status: .done, icon: .code, title: "Пишу", startedAt: 1, finishedAt: 2, liveCode: AgentLiveCode(fileName: "app.js", language: "javascript", text: draft.files[2].text, linesPerSecond: 18))
+        let run = AgentRun(id: 2, status: .finished, startedAt: 0, finishedAt: 30, steps: [step])
+
+        for payload in [AgentMessagePayload(run: run, artifact: nil), AgentMessagePayload(run: nil, artifact: artifact)] {
+            let data = payload.encoded()
+            XCTAssertLessThan(data.count, 64 * 1024)
+            XCTAssertEqual(AgentMessagePayload.decode(data), payload)
+        }
+
+        let html = artifact.assembledHTML(themeCSS: ":root { --tg-theme-bg-color: #000000; }")
+        XCTAssertNotNil(html)
+        XCTAssertFalse(html!.contains("<link rel=\"stylesheet\""))
+        XCTAssertFalse(html!.contains("<script src="))
+        XCTAssertTrue(html!.contains("--tg-theme-bg-color: #000000"))
+    }
+
+    func testSummaries() {
+        let steps = (0 ..< 8).map { AgentStep(id: "s\($0)", kind: .tool, status: .done, icon: .code, title: "t", startedAt: 0, finishedAt: 1) }
+        let run = AgentRun(id: 1, status: .finished, startedAt: 0, finishedAt: 72, steps: steps)
+        XCTAssertEqual(AgentFormatting.summary(run: run, now: 100, isRussian: true), "Работал 1 мин 12 с · 8 шагов")
+        var stopped = run
+        stopped.status = .stopped
+        stopped.finishedAt = 24
+        stopped.steps = Array(steps.prefix(3))
+        XCTAssertEqual(AgentFormatting.summary(run: stopped, now: 100, isRussian: true), "Остановлено через 24 с · 3 шага")
+        XCTAssertEqual(AgentFormatting.thought(seconds: 4, isRussian: true), "Думал 4 с")
+    }
+
+    private func containsEmoji(_ text: String) -> Bool {
+        return text.unicodeScalars.contains(where: { scalar in
+            return scalar.properties.isEmojiPresentation || (0x1F300 ... 0x1FAFF).contains(scalar.value)
+        })
+    }
+}
