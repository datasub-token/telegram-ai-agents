+import XCTest
+@testable import AsciiRevealCore
+
+final class AsciiRevealCoreTests: XCTestCase {
+    func testHashIsDeterministicAndUniform() {
+        XCTAssertEqual(asciiHash(7, 42), asciiHash(7, 42))
+        XCTAssertNotEqual(asciiHash(7, 42), asciiHash(8, 42))
+        var sum = 0.0
+        for index in 0 ..< 10_000 {
+            let value = asciiHash(3, index)
+            XCTAssertGreaterThanOrEqual(value, 0.0)
+            XCTAssertLessThan(value, 1.0)
+            sum += value
+        }
+        XCTAssertEqual(sum / 10_000.0, 0.5, accuracy: 0.02)
+    }
+
+    func testWaveDelayIsCappedOnlyAtFastPace() {
+        XCTAssertEqual(asciiWaveDelay(distance: 32.0, pace: .fast), 10.0, accuracy: 0.001)
+        XCTAssertEqual(asciiWaveDelay(distance: 10_000.0, pace: .fast), 220.0)
+        XCTAssertGreaterThan(asciiWaveDelay(distance: 10_000.0, pace: .cinematic), 1000.0)
+    }
+
+    func testFastTextScheduleIsReadableQuickly() {
+        let schedule = AsciiTextSchedule(count: 24, seed: 1, pace: .fast)
+        for k in 0 ..< schedule.count {
+            XCTAssertLessThan(schedule.starts[k], schedule.ends[k])
+        }
+        // "Worked for 27 s · 7 steps" settles in well under half a second.
+        XCTAssertLessThan(schedule.durationMs, 450.0)
+        XCTAssertGreaterThan(schedule.durationMs, 90.0)
+        // Characters start roughly left to right.
+        XCTAssertLessThan(schedule.starts[0], schedule.starts[schedule.count - 1])
+    }
+
+    func testTextStatesGoFromHiddenToLockedAndTheFlashFades() {
+        let schedule = AsciiTextSchedule(count: 10, seed: 5, pace: .fast)
+        let k = 4
+        XCTAssertEqual(schedule.state(index: k, timeMs: schedule.starts[k] - 1.0, preset: .decode), .hidden)
+        if case .glyph = schedule.state(index: k, timeMs: schedule.starts[k] + 1.0, preset: .decode) {
+        } else {
+            XCTFail("a starting character scrambles")
+        }
+        XCTAssertEqual(schedule.state(index: k, timeMs: schedule.ends[k], preset: .decode), .locked(flash: 1.0))
+        XCTAssertEqual(schedule.state(index: k, timeMs: schedule.ends[k] + AsciiTextSchedule.flashMs, preset: .decode), .locked(flash: 0.0))
+        XCTAssertEqual(schedule.state(index: 99, timeMs: 0.0, preset: .decode), .hidden)
+    }
+
+    func testDecodeCondensesThroughItsRampWithoutSpaces() {
+        let schedule = AsciiTextSchedule(count: 40, seed: 9, pace: .cinematic)
+        let ramp = Set(AsciiPresetSpec.decode.ramp.dropFirst())
+        for k in 0 ..< schedule.count {
+            let early = schedule.starts[k] + (schedule.ends[k] - schedule.starts[k]) * 0.3
+            guard case let .glyph(character) = schedule.state(index: k, timeMs: early, preset: .decode) else {
+                return XCTFail("character \(k) is not scrambling at 30%")
+            }
+            XCTAssertTrue(ramp.contains(character), "\(character) is not a visible ramp glyph")
+        }
+    }
+
+    func testTerminalShowsItsCursorFirstAndNumbersStayDigits() {
+        let schedule = AsciiTextSchedule(count: 6, seed: 2, pace: .fast)
+        XCTAssertEqual(schedule.state(index: 0, timeMs: schedule.starts[0], preset: .terminal), .cursor)
+        let late = schedule.starts[1] + (schedule.ends[1] - schedule.starts[1]) * 0.9
+        guard case let .glyph(digit) = schedule.state(index: 1, timeMs: late, preset: .decode, isNumeric: true) else {
+            return XCTFail("a number scrambles")
+        }
+        XCTAssertTrue(digit.isNumber)
+    }
+
+    func testSpeedScalesTheSchedule() {
+        let normal = AsciiTextSchedule(count: 12, seed: 4, pace: .fast)
+        let double = AsciiTextSchedule(count: 12, seed: 4, pace: .fast, speed: 2.0)
+        XCTAssertEqual(double.durationMs, normal.durationMs / 2.0, accuracy: 0.001)
+    }
+
+    func testImageStepsRefineAndEveryCellShowsBeforeTheCrossfade() {
+        XCTAssertEqual(AsciiImageMath.step(q: 0.0, stepCount: 5), 0)
+        XCTAssertEqual(AsciiImageMath.step(q: 0.79, stepCount: 5), 4)
+        XCTAssertEqual(AsciiImageMath.step(q: 1.0, stepCount: 5), 4)
+        var previous = 0
+        for i in 0 ... 100 {
+            let step = AsciiImageMath.step(q: Double(i) / 100.0, stepCount: 5)
+            XCTAssertGreaterThanOrEqual(step, previous)
+            previous = step
+        }
+        // The farthest, unluckiest cell is visible by q = 1 / 2.3, long before the image fades in at 0.68.
+        XCTAssertTrue(AsciiImageMath.isCellVisible(hash: 0.999, distance: 100.0, maxDistance: 100.0, q: 0.44))
+        XCTAssertFalse(AsciiImageMath.isCellVisible(hash: 0.999, distance: 100.0, maxDistance: 100.0, q: 0.2))
+        XCTAssertTrue(AsciiImageMath.isCellVisible(hash: 0.0, distance: 0.0, maxDistance: 100.0, q: 0.0))
+    }
+
+    func testImageGlyphsSkipTheBackground() {
+        XCTAssertNil(AsciiImageMath.glyphIndex(ink: 0.01, flicker: nil, rampCount: 5))
+        XCTAssertEqual(AsciiImageMath.glyphIndex(ink: 1.0, flicker: nil, rampCount: 5), 4)
+        let ink = AsciiImageMath.ink(luminance: 0.2, backgroundLuminance: 0.95)
+        XCTAssertGreaterThan(ink, 0.7)
+        XCTAssertEqual(AsciiImageMath.ink(luminance: 0.5, backgroundLuminance: 0.5), 0.0)
+    }
+
+    func testImageCrossfade() {
+        XCTAssertEqual(AsciiImageMath.imageOpacity(q: 0.5), 0.0)
+        XCTAssertEqual(AsciiImageMath.imageOpacity(q: 1.0), 1.0, accuracy: 0.0001)
+        XCTAssertEqual(AsciiImageMath.glyphOpacity(q: 0.5), 1.0)
+        XCTAssertEqual(AsciiImageMath.glyphOpacity(q: 1.0), 0.0, accuracy: 0.0001)
+        XCTAssertEqual(AsciiImageMath.cellScale(width: 300.0, height: 187.0), 187.0 / 230.0, accuracy: 0.0001)
+        XCTAssertEqual(AsciiImageMath.cellScale(width: 60.0, height: 40.0), 0.4)
+    }
+
+    func testSkeletonBandSweepsAcrossAndStaggersRows() {
+        let width = 200.0
+        let start = AsciiSkeletonMath.bandX(time: 0.0, row: 0, width: width)
+        let middle = AsciiSkeletonMath.bandX(time: AsciiSkeletonMath.cycle / 2.0, row: 0, width: width)
+        XCTAssertLessThan(start, 0.0)
+        XCTAssertGreaterThan(middle, start)
+        XCTAssertNotEqual(AsciiSkeletonMath.bandX(time: 0.5, row: 0, width: width), AsciiSkeletonMath.bandX(time: 0.5, row: 3, width: width))
+        XCTAssertEqual(AsciiSkeletonMath.brightness(x: middle - 1.0, bandX: middle, width: width), 0.0)
+        XCTAssertGreaterThan(AsciiSkeletonMath.brightness(x: middle + width * AsciiSkeletonMath.bandFraction / 2.0, bandX: middle, width: width), 0.8)
+        XCTAssertEqual(AsciiSkeletonMath.stripAlpha(0.5), 1.0)
+        XCTAssertEqual(AsciiSkeletonMath.stripAlpha(0.0), 0.0)
+    }
+
+    func testTypingLocksANewLineQuicklyAndTheCursorBlinks() {
+        XCTAssertEqual(AsciiTypingMath.lockedFraction(elapsed: 0.0), 0.0)
+        XCTAssertEqual(AsciiTypingMath.lockedFraction(elapsed: 0.075), 0.5, accuracy: 0.0001)
+        XCTAssertEqual(AsciiTypingMath.lockedFraction(elapsed: 1.0), 1.0)
+        XCTAssertTrue(AsciiTypingMath.isCursorVisible(time: 0.1))
+        XCTAssertFalse(AsciiTypingMath.isCursorVisible(time: 0.6))
+        XCTAssertTrue(AsciiTypingMath.isCursorVisible(time: 1.1))
+    }
+}
